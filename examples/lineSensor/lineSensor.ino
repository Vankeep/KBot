/*
 * Пример использования датчиков линии для следования по линии
 *
 * Подключение:
 * 1. Подключите датчики линии к разъемам XP8 и XP11
 * 2. Загрузите скетч на M5Stack Core2
 * 3. На экране будут отображаться состояния датчиков (на линии/не на линии)
 * 4. Разместите датчики над черной линией для тестирования
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

// Переменные для хранения текущего состояния датчиков линии
// true - датчик над черной линией, false - датчик над белой поверхностью
bool isSens1;  // Состояние первого датчика (подключен к XP8)
bool isSens2;  // Состояние второго датчика (подключен к XP11)

// Флаг необходимости обновления экрана
// Нужно чтобы не обновлять экран каждый цикл, а только при изменении состояния
bool isOledUpdate;

void setup(){
    bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
    
    // Инициализируем датчики линии
    // Датчик линии возвращает true если видит черную поверхность, false если белую
    bot.lineSensor1.begin(Connector::Name::XP8);  // Первый датчик к разъему XP8
    bot.lineSensor2.begin(Connector::Name::XP11); // Второй датчик к разъему XP11
    
    // Выводим заголовок на первую строку экрана
    // Показываем названия разъемов к которым подключены датчики
    bot.oled.printStr1("XP8 | XP11");
}

void loop(){
    bot.update();  // Обновляем состояние всех датчиков (вызываем каждый цикл!)

    // Проверяем, изменилось ли состояние первого датчика
    // isOnLine() возвращает true если датчик над черной линией
    // != означает "не равно", то есть проверяем отличие текущего состояния от сохраненного
    if(bot.lineSensor1.isOnLine() != isSens1){
        isSens1 = !isSens1;  // Инвертируем сохраненное состояние (если было true, станет false)
        isOledUpdate = true; // Помечаем что нужно обновить экран
    }

    // Аналогично проверяем второй датчик
    if(bot.lineSensor2.isOnLine() != isSens2){
        isSens2 = !isSens2;  // Инвертируем сохраненное состояние
        isOledUpdate = true; // Помечаем что нужно обновить экран
    }

    // Если состояние любого датчика изменилось - обновляем экран
    if(isOledUpdate){
        // Выводим состояния датчиков на вторую строку экрана
        // String() - преобразует boolean в строку ("true" или "false")
        // Формат: "true   | false" означает: первый датчик на линии, второй - нет
        bot.oled.printStr2(String(isSens1) + "   | " + String(isSens2));
        
        isOledUpdate = false;  // Сбрасываем флаг, обновление завершено
    }
}