/*
 * Пример использования WiFi Control Panel для управления роботом с телефона
 *
 * Подключение:
 * 1. Загрузите скетч на M5Stack Core2
 * 2. На телефоне подключитесь к WiFi сети "kbot" (пароль: "12345678")
 * 3. Откройте браузер и перейдите по адресу, показанному на экране M5Stack
 * 4. Используйте джойстик для управления роботом
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

void setup() {
    bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)

    // Инициализация WiFi точки доступа
    // begin(SSID, пароль, IP-адрес) - создаем WiFi сеть с указанными параметрами
    // "kbot" - имя сети (SSID), которое будет видно при подключении
    // "12345678" - пароль для подключения к сети
    // IPAddress(10, 0, 0, 1) - IP-адрес робота в сети (10.0.0.1)
    bot.wifiControl.begin("kbot", "12345678", IPAddress(10, 0, 0, 1));

    // Выводим на экран информацию для подключения к пульту управления
    // getSSID() - возвращает имя WiFi сети
    bot.oled.printStr1("wifi name:" + String(bot.wifiControl.getSSID()));
    
    // getPassword() - возвращает пароль WiFi сети
    bot.oled.printStr2("wifi password:" + String(bot.wifiControl.getPassword()));
    
    // getIPAddress() - возвращает IP-адрес робота
    // По этому адресу нужно перейти в браузере телефона для открытия пульта
    bot.oled.printStr3("url: http://" + String(bot.wifiControl.getIPAddress()));
}

void loop() {
    bot.update();  // Обновляем состояние всех датчиков и WiFi контроллера (вызываем каждый цикл!)

    // Переменные для хранения значений от джойстика
    // left - скорость левого мотора, right - скорость правого мотора
    // Значения от -100 до 100: положительное - вперед, отрицательное - назад
    int left, right;
    
    // Получаем значения от виртуального джойстика с пульта управления
    // getMotorValues() записывает в переменные left и right текущие значения джойстика
    bot.wifiControl.getMotorValues(left, right);

    // Управляем моторами на основе значений от джойстика
    // drive(левый, правый) - устанавливает скорость для каждого мотора
    bot.wheel.drive(left, right);
}
