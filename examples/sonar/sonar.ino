/*
 * Пример использования ультразвукового датчика расстояния
 *
 * Подключение:
 * 1. Загрузите скетч на M5Stack Core2
 * 2. На экране будет отображаться расстояние до препятствия в миллиметрах
 * 3. Используйте для обнаружения препятствий на пути робота
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

void setup(){
  bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
}

void loop(){
  bot.update();  // Обновляем состояние всех датчиков (вызываем каждый цикл!)

  // Считываем расстояние с ультразвукового датчика в миллиметрах
  // Ультразвуковой датчик работает как эхолот - посылает звуковую волну и слушает эхо
  int mm = bot.ultrasonic.getDistanceMm();

  // Выводим расстояние на первую строку экрана
  bot.oled.printStr1("Dist = " + String(mm) + " mm");
}