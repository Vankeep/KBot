/*
 * Пример использования ToF датчика расстояния для автоматической остановки
 *
 * Подключение:
 * 1. Загрузите скетч на M5Stack Core2
 * 2. Робот будет двигаться вперед пока расстояние до препятствия больше 100мм
 * 3. При приближении к препятствию робот остановится
 * 4. На экране отображается текущее расстояние
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

void setup(){
  bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
}

void loop(){
  bot.update();  // Обновляем состояние всех датчиков (вызываем каждый цикл!)

  // Считываем расстояние до препятствия с ToF датчика в миллиметрах
  // ToF (Time of Flight) - измеряет расстояние по времени полета лазерного луча
  int mm = bot.tof.getDistance();

  if(mm > 100){  // Если расстояние больше 100мм (свободный путь)
    bot.wheel.drive(50,50);  // Едем вперед со скоростью 50
  } else {  // Если препятствие близко (100мм или меньше)
    bot.wheel.drive(0,0);  // Останавливаем моторы
  }

  // Выводим расстояние на первую строку экрана
  bot.oled.printStr1("tof distance = " + String(mm) + " mm");
}