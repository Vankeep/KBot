/*
 * Пример использования моторов для движения робота
 *
 * Подключение:
 * 1. Загрузите скетч на M5Stack Core2
 * 2. Робот начнет движение вперед на скорости 50
 * 3. Раскомментируйте другие строки для разных вариантов движения
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

void setup(){
  bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
}

void loop(){
  bot.update();  // Обновляем состояние всех датчиков (вызываем каждый цикл!)

  // Запускаем оба мотора со скоростью 50 (робот едет вперед)
  // Скорость от -100 до 100: положительная - вперед, отрицательная - назад
  bot.wheel.drive(50, 50);

  // Другие варианты управления моторами (закомментированы):
  // bot.wheel.drive(-80, -80);  // Оба мотора назад - робот едет назад
  // bot.wheel.drive(Wheel::Name::XP14A, 50);  // Управление только левым передним мотором
  // bot.wheel.drive(Wheel::Name::XP15A, -50); // Управление только правым передним мотором
  // bot.wheel.drive(Wheel::Name::XP14B, 50);  // Управление только левым задним мотором
  // bot.wheel.drive(Wheel::Name::XP15B, -50); // Управление только правым задним мотором
}