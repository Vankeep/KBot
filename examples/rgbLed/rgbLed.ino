/*
 * Пример использования RGB светодиодной ленты для создания эффектов
 *
 * Подключение:
 * 1. Подключите RGB ленту на 6 светодиодов к разъему XP11
 * 2. Загрузите скетч на M5Stack Core2
 * 3. Светодиоды будут циклически менять цвета (красный, зеленый, синий, желтый, голубой, пурпурный)
 * 4. Смена цветов происходит каждые 200мс
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

// Массив цветов для светодиодов
// Led::Color - перечисление с названиями цветов: RED, GREEN, BLUE, YELLOW, CYAN, MAGENTA
Led::Color colors[6] = {
  Led::Color::RED,     // Красный
  Led::Color::GREEN,   // Зеленый
  Led::Color::BLUE,    // Синий
  Led::Color::YELLOW,  // Желтый
  Led::Color::CYAN,    // Голубой
  Led::Color::MAGENTA  // Пурпурный
};

int offset = 0;  // Переменная для смещения цветов (создает эффект бегущей волны)

void setup() {
  bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
  
  // Инициализируем RGB ленту
  // Connector::Name::XP11 - разъем подключения, 6 - количество светодиодов в ленте
  bot.rgbLed.begin(Connector::Name::XP11, 6);
  
  // Устанавливаем яркость светодиодов (0-255)
  // 125 - средняя яркость (примерно 50% от максимальной)
  bot.rgbLed.setBrightness(125);
  
  // Запускаем таймер, который срабатывает каждые 200 миллисекунд
  // Используем для периодической смены цветов
  bot.timer1.startEvery(200);
}

void loop() {
  bot.update();  // Обновляем состояние всех датчиков и таймеров (вызываем каждый цикл!)

  // Проверяем, готов ли таймер (прошло 200мс с последнего срабатывания)
  if (bot.timer1.isReady()) {
    // Проходим по всем светодиодам в ленте
    // getNumLeds() возвращает количество подключенных светодиодов
    for (int i = 0; i < bot.rgbLed.getNumLeds(); i++) {
      // Вычисляем индекс цвета для текущего светодиода
      // Оператор % (остаток от деления) обеспечивает циклический переход: 0,1,2,3,4,5,0,1,2...
      int colorIndex = (i + offset) % 6;
      
      // Устанавливаем цвет для i-го светодиода
      // Нумерация светодиодов начинается с 1 (не с 0!)
      bot.rgbLed.setColor(i + 1, colors[colorIndex]);
    }
    
    // Увеличиваем смещение для следующего цикла
    // Это создает эффект движения цветов по ленте
    // % 6 обеспечивает циклическое изменение от 0 до 5
    offset = (offset + 1) % 6;
  }
}