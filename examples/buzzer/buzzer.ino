/*
 * Пример использования пьезодинамика для воспроизведения мелодии
 *
 * Подключение:
 * 1. Подключите пьезодинамик к разъему XP11
 * 2. Загрузите скетч на M5Stack Core2
 * 3. При запуске прозвучат три ноты вверх
 * 4. Затем воспроизведется мелодия из игры Mario
 */

#include <KBot.h>  // Подключаем библиотеку для работы с роботом KBot

KBot bot;  // Создаем объект робота

// Массив с нотами мелодии из игры Super Mario
// Числа - это частоты нот в Герцах (Гц)
// 0 обозначает паузу (тишина)
int mario[] = {
    659, 659,   0, 659,   0, 523, 659,   0, 784,   0,   0, 392
//   Ми   Ми       Ми        До   Ми        Соль           Соль
};

int marioLength = 12;  // Количество нот в мелодии (длина массива)
int noteIndex = 0;      // Индекс текущей ноты - какую ноту сейчас играем (от 0 до 11)
bool melodyDone = false; // Флаг завершения мелодии: false - играет, true - закончила

void setup() {
    bot.begin();  // Инициализируем робота (запускаем все датчики и моторы)
    
    // Инициализируем пьезодинамик (buzzer) к разъему XP11
    bot.buzzer.begin(Connector::Name::XP11);

    // Проигрываем три ноты вверх при старте (сигнал готовности)
    // tone(частота, длительность) - воспроизводит звук указанной частоты в миллисекундах
    bot.buzzer.tone(1000, 100);  // Первая нота - 1000 Гц, длится 100мс
    delay(150);  // Пауза 150мс между нотами (delay останавливает выполнение программы)
    
    bot.buzzer.tone(1500, 100);  // Вторая нота - 1500 Гц, длится 100мс
    delay(150);  // Пауза 150мс между нотами
    
    bot.buzzer.tone(2000, 300);  // Третья нота - 2000 Гц, длится 300мс
    delay(500);  // Пауза 500мс перед началом мелодии

    // Запускаем таймер для воспроизведения мелодии
    // startEvery(200) - таймер срабатывает каждые 200 миллисекунд
    bot.timer1.startEvery(200);
}

void loop() {
    bot.update();  // Обновляем состояние всех датчиков и таймеров (вызываем каждый цикл!)

    // Проверяем два условия:
    // 1. bot.timer1.isReady() - прошло ли 200мс с последнего срабатывания таймера
    // 2. melodyDone == false - мелодия ещё не закончилась
    // && означает "И" - оба условия должны быть истинны
    if(bot.timer1.isReady() && melodyDone == false) {

        // Проверяем, есть ли ещё ноты для воспроизведения
        if(noteIndex < marioLength) {
            // Проверяем текущую ноту: если 0 - это пауза, иначе - играем ноту
            if(mario[noteIndex] == 0) {
                // noTone() - выключает звук (пауза в мелодии)
                bot.buzzer.noTone();
            } else {
                // tone(частота, длительность) - воспроизводим ноту указанной частоты
                // 150 - длительность ноты в миллисекундах
                bot.buzzer.tone(mario[noteIndex], 150);
            }
            
            // Переходим к следующей ноте (увеличиваем индекс на 1)
            noteIndex++;
        } else {
            // Все ноты сыграны - выключаем звук
            bot.buzzer.noTone();
            
            // Помечаем что мелодия завершена
            melodyDone = true;
        }
    }
}